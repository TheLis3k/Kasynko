<script>
var gameTypes = {};
document.querySelectorAll('#game_id option').forEach(function(o) {
    gameTypes[o.value] = o.dataset.type;
});

function switchBetValue(type) {
    ['number','color','parity','bet'].forEach(function(k) {
        document.getElementById('bv-' + k).classList.toggle('active', k === type);
    });
}

function syncTypeOptions(gameId) {
    var gameType = gameTypes[gameId] || '';
    var sel = document.getElementById('bet_type');
    sel.querySelectorAll('option').forEach(function(o) {
        o.hidden = (gameType === 'slots') ? (o.value !== 'bet') : (o.value === 'bet');
    });
    var first = Array.from(sel.options).find(function(o) { return !o.hidden; });
    if (first) { sel.value = first.value; switchBetValue(first.value); }
}

switchBetValue(document.getElementById('bet_type').value);
syncTypeOptions(document.getElementById('game_id').value);
</script>

