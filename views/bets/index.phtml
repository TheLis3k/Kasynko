function sortUrl(string $col, string $currentSort, string $currentDir, array $filters): string {
    $dir = ($currentSort === $col && $currentDir === 'ASC') ? 'DESC' : 'ASC';
    $q = array_merge($filters, ['sort' => $col, 'dir' => $dir]);
    return '?' . http_build_query($q);
}
function arrow(string $col, string $currentSort, string $currentDir): string {
    if ($currentSort !== $col) return '';
    return $currentDir === 'ASC' ? ' &#8593;' : ' &#8595;';
}
