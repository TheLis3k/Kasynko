<?php $pageTitle = t('nav.roulette'); require dirname(__DIR__) . '/layout/header.phtml'; ?>
<?php
$redNumbers = [1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36];
function rouletteColor(int $n, array $reds): string {
    if ($n === 0)               return '#1e7e34'; // green
    return in_array($n, $reds) ? '#c0392b' : '#1a1a1a'; // red / black
}
?>
<style>
.roulette-result{text-align:center;margin-bottom:1.5rem}
.roulette-wheel{
    display:inline-flex;align-items:center;justify-content:center;
    width:100px;height:100px;border-radius:50%;
    font-size:2.5rem;font-weight:700;color:#fff;
    border:4px solid var(--color-gold);
    margin-bottom:.8rem;
}
.roulette-wheel.spin{animation:rouletteSpin .8s cubic-bezier(.17,.67,.83,.67)}
@keyframes rouletteSpin{
    0%{transform:rotate(0deg)}
    60%{transform:rotate(1080deg)}
    80%{transform:rotate(1060deg)}
    100%{transform:rotate(1080deg)}
}
.bet-value-group{display:none}
.bet-value-group.active{display:block}
</style>

<div class="game-wrap">
    <div class="card">
        <div class="card__title">&#9900; <?= t('nav.roulette') ?></div>

        <?php if ($result): ?>
        <div class="roulette-result">
            <?php $wheelColor = rouletteColor((int)$result['winning_number'], $redNumbers); ?>
