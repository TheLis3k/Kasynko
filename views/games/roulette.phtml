            <?php else: ?>
                <p style="color:var(--color-error);font-size:1.1rem"><?= t('game.lose') ?></p>
            <?php endif; ?>
        </div>
        <?php endif; ?>

        <form method="post" action="/roulette">
            <input type="hidden" name="_csrf" value="<?= csrf_token() ?>">

            <div class="form-group">
                <label for="bet_type"><?= t('game.bet_type') ?></label>
                <select id="bet_type" name="bet_type" onchange="switchBetType(this.value)">
