                <select name="bet_value_parity">
                    <?php $lastParity = ($lastType === 'parity') ? ($result['bet_value'] ?? 'even') : 'even'; ?>
                    <option value="even" <?= $lastParity === 'even' ? 'selected' : '' ?>><?= t('game.even') ?></option>
                    <option value="odd"  <?= $lastParity === 'odd'  ? 'selected' : '' ?>><?= t('game.odd') ?></option>
                </select>
