                    <option value="color"  <?= $lastType === 'color'  ? 'selected' : '' ?>><?= t('game.color') ?></option>
                    <option value="parity" <?= $lastType === 'parity' ? 'selected' : '' ?>><?= t('game.parity') ?></option>
                </select>
            </div>

            <div id="val-number" class="form-group bet-value-group <?= $lastType === 'number' ? 'active' : '' ?>">
                <label><?= t('game.number') ?></label>
                <input type="number" name="bet_value_number" min="0" max="36" step="1"
                       value="<?= ($lastType === 'number') ? (int)($result['bet_value'] ?? 0) : 0 ?>">
            </div>
            <div id="val-color" class="form-group bet-value-group <?= $lastType === 'color' ? 'active' : '' ?>">
                <label><?= t('game.color') ?></label>
                <select name="bet_value_color">
                    <?php $lastColor = ($lastType === 'color') ? ($result['bet_value'] ?? 'red') : 'red'; ?>
                    <option value="red"   <?= $lastColor === 'red'   ? 'selected' : '' ?>><?= t('game.red') ?></option>
                    <option value="black" <?= $lastColor === 'black' ? 'selected' : '' ?>><?= t('game.black') ?></option>
                </select>
            </div>
            <div id="val-parity" class="form-group bet-value-group <?= $lastType === 'parity' ? 'active' : '' ?>">
